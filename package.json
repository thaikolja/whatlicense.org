{
  "name":            "whatlicense-org",
  "type":            "module",
  "private":         true,
  "packageManager":  "bun@1.3.14",
  "scripts":         {
    "build":         "nuxt build",
    "dev":           "nuxt dev",
    "generate":      "nuxt generate",
    "preview":       "nuxt preview",
    "postinstall":   "nuxt prepare",
    "lint": "eslint .",
    "deploy":        "wrangler pages deploy dist",
    "test":          "node ./node_modules/vitest/vitest.mjs run",
    "test:watch":    "node ./node_modules/vitest/vitest.mjs",
    "test:unit":     "node ./node_modules/vitest/vitest.mjs run --project unit",
    "test:nuxt":     "node ./node_modules/vitest/vitest.mjs run --project nuxt",
    "test:e2e":      "node ./node_modules/vitest/vitest.mjs run --project e2e",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage --project unit --project nuxt"
  },
  "dependencies":    {
    "@lucide/vue":              "^1.28.0",
    "@nuxt/content":            "^3.15.2",
    "@nuxt/eslint":             "^1.16.0",
    "@nuxt/icon":               "^2.4.1",
    "@nuxtjs/seo":              "^5.3.6",
    "@takumi-rs/core":          "^2.5.4",
    "@unhead/vue":              "^3.2.3",
    "better-sqlite3":           "13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx":                     "^2.1.1",
    "highlight.js":             "^11.11.1",
    "nuxt":                     "^4.5.1",
    "reka-ui":                  "^2.10.1",
    "shadcn-vue":               "^2.8.1",
    "simple-analytics-vue":     "^3.1.0",
    "tailwind-merge":           "^3.6.0",
    "tw-animate-css":           "^1.4.0",
    "unhead":                   "^3.2.3",
    "vue":                      "^3.5.40",
    "vue-router":               "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/mdi":    "^1.2.3",
    "@nuxt/fonts":          "^0.14.0",
    "@nuxt/test-utils":     "^4.1.0",
    "@tailwindcss/vite":    "^4.3.3",
    "@vitest/coverage-v8":  "^4",
    "@vue/test-utils":      "^2.4.11",
    "happy-dom":            "^20.11.1",
    "shadcn-nuxt":          "^2.8.1",
    "tailwindcss":          "^4.3.3",
    "terser":               "^5.49.0",
    "vitest":               "^4"
  }
}
